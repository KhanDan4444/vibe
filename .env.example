# Server
PORT=5000
NODE_ENV=development
# Calendar "today" for payment/term rules (IANA TZ). Default: Africa/Addis_Ababa
# APP_TIMEZONE=Africa/Addis_Ababa

# PostgreSQL (local dev)
DB_USER=postgres
DB_HOST=localhost
DB_DATABASE=gym_saas
DB_PASSWORD=
DB_PORT=5432

# Cloud (Neon + Railway): use DATABASE_URL instead of the vars above
# DATABASE_URL=postgresql://user:pass@host/db?sslmode=require
# DB_SSL=1   — required when using DB_HOST/DB_* against Neon (not needed with DATABASE_URL)

# Auth — required; server refuses to start without JWT_SECRET
JWT_SECRET=change-me-to-a-long-random-string
# Optional: dedicated secret for member QR passes (falls back to JWT_SECRET)
# MEMBER_PASS_SECRET=change-me-to-another-long-random-string

# Dev-only: secret for POST /api/auth/register-admin (disabled in production)
# Send as header: X-Admin-Setup-Secret: <value>
ADMIN_SETUP_SECRET=dev-only-change-me

# CORS allowlist (comma-separated frontend origins)
# Dev: optional — defaults to http://localhost:5173 and other local Vite ports
# Production: required — server exits on startup if unset
# ALLOWED_ORIGINS=http://localhost:5173,https://your-app.example.com

# Set to 1 when behind a reverse proxy (needed for accurate rate-limit IP)
# TRUST_PROXY=1

# Frontend URL (public links, CORS-related helpers)
FRONTEND_URL=http://localhost:5173

# Platform support for gym owners (shown in portal / forgot-password / lockout)
# Ethiopian mobile E.164 or national digits. Optional Telegram username (no @).
# SUPPORT_PHONE=+2519XXXXXXXX
# SUPPORT_TELEGRAM=YourSupportBotOrUser

# Email (optional — without SMTP, emails are logged to the server console)
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=0
# SMTP_USER=your-user
# SMTP_PASS=your-password
# SMTP_FROM=Niku <noreply@example.com>

# SMS provider switch — keep both credential sets; pick one with SMS_PROVIDER.
#   SMS_PROVIDER=hahu  → Android phone gateway (now, no business license)
#   SMS_PROVIDER=afro  → Afro Message cloud (later, after sender/KYC approval)
# If unset: uses hahu when HAHU_* is set, else afro when AFRO_MESSAGE_TOKEN is set.
# SMS_PROVIDER=hahu
#
# --- hahu.io (Android SMS gateway) https://hahu.io/dashboard/docs ---
# Tools → API Keys = HAHU_API_SECRET; Devices → copy device UUID = HAHU_DEVICE_ID
# Phone must stay online with the hahu app + SIM. Free starter: 2,000 SMS/day.
# HAHU_API_SECRET=your-api-key
# HAHU_DEVICE_ID=00000000-0000-0000-xxxx-xxxxxxxxxxxx
# HAHU_SIM=1
# HAHU_PRIORITY=1
# Optional: HAHU_API_BASE=https://hahu.io
#
# --- Afro Message (cloud, keep for later) https://www.afromessage.com/developers ---
# Leave token set even while using hahu — switch back with SMS_PROVIDER=afro only.
# Without any provider configured, OTP codes and SMS are logged to the console (dev only).
# AFRO_MESSAGE_TOKEN=your-api-token
# Beta: do not set SENDER or FROM — Afro applies the default sender (AfroMessage) automatically.
# After your custom sender is approved: AFRO_MESSAGE_SENDER=YourVerifiedName
# Optional identifier (Identifiers page): AFRO_MESSAGE_FROM=your-identifier-id
# AFRO_MESSAGE_OTP_TTL=600
# AFRO_MESSAGE_OTP_LENGTH=6
# Optional local OTP HMAC when using hahu: SMS_OTP_HMAC_SECRET=random-long-secret

# Telegram Bot (member notifications — pass links, expiry reminders)
# Create via https://t.me/BotFather → copy token and bot username (without @).
# TELEGRAM_BOT_TOKEN=123456:ABC-DEF...
# TELEGRAM_BOT_USERNAME=NikuGymBot
# Webhook secret — set the same value when registering the webhook with Telegram.
# TELEGRAM_WEBHOOK_SECRET=random-long-secret
# Public HTTPS URL for production webhook (dev can use ngrok or skip — logs only without token).
# TELEGRAM_WEBHOOK_URL=https://api.yourdomain.com/api/telegram/webhook

# Public gym self-registration (set to 0 to disable)
PUBLIC_GYM_SIGNUP_ENABLED=1
# Free trial for self-service signup (days, including registration day).
# Leave 0 / unset to assign a SaaS plan (no trial). Set e.g. 14 or 30 to enable trial signup.
GYM_SIGNUP_TRIAL_DAYS=0
# Optional: SaaS plan id used when trial is disabled (defaults to cheapest active plan)
# GYM_SIGNUP_DEFAULT_SAAS_PLAN_ID=

# PostgreSQL connection pool (optional tuning)
# DB_POOL_MAX=20
# DB_IDLE_TIMEOUT_MS=30000
# DB_CONNECTION_TIMEOUT_MS=5000

# Sentry error monitoring (optional — leave unset in local dev)
# Create a Node.js project at https://sentry.io → Settings → Client Keys (DSN)
# SENTRY_DSN=https://<key>@o<org>.ingest.sentry.io/<project>
# SENTRY_ENVIRONMENT=production
# Optional performance sampling 0–1 (default 0 = errors only)
# SENTRY_TRACES_SAMPLE_RATE=0
# Optional release tag (e.g. git SHA on deploy)
# SENTRY_RELEASE=
